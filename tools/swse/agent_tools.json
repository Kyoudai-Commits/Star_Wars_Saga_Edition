{
  "schema_version": 1,
  "protocol": "Repository-specific JSON-lines adapter; not an MCP implementation.",
  "tools": [
    {
      "name": "resolve",
      "input_schema": {
        "type": "object",
        "properties": {
          "book": {
            "type": "string"
          },
          "include_homebrew": {
            "type": "boolean",
            "default": false
          },
          "include_optional": {
            "type": "boolean",
            "default": false
          },
          "include_unreviewed": {
            "type": "boolean",
            "default": true
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Exact local name, alias or entity ID; ambiguous variants are not merged."
          },
          "variant": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "transport": "One JSON line: {\"id\": ..., \"method\": name, \"params\": arguments}; read-only, offline."
    },
    {
      "name": "search",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
